server {
    listen 80;
    listen [::]:80;
    server_name ardalab.com.tr www.ardalab.com.tr;

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ardalab.com.tr www.ardalab.com.tr;

    ssl_certificate /etc/letsencrypt/live/ardalab.com.tr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ardalab.com.tr/privkey.pem;

    # Form/fotoğraf yükleme boyutu (next.config.ts serverActions.bodySizeLimit ile uyumlu olmalı)
    client_max_body_size 30M;

    # Next.js uygulamasına yönlendir (3001 portu: PioneerCY ile çakışmasın)
    location / {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Çoklu fotoğraf yüklemeleri (proje/daire tipi galerileri) uzun sürebilir
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Static dosyalar
    location /_next/static {
        proxy_pass http://localhost:3001;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
